<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Rule PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<Rule language="beanshell" name="Remove_DEVU6_Entitlement">
  <Description>Removes the DEVU6NETSECTEST group (memberOf) from the R6-Core AD account of identity IVPT5898.</Description>
  <Source><![CDATA[
import java.util.*;
import sailpoint.api.IdentityService;
import sailpoint.api.Provisioner;
import sailpoint.object.*;
import sailpoint.object.ProvisioningPlan.AccountRequest;
import sailpoint.object.ProvisioningPlan.AttributeRequest;
import sailpoint.tools.Message;
import sailpoint.tools.Util;

String identityName = "IVPT5898";
String appName      = "R6-Core";
String attrName     = "memberOf";
String groupName    = "DEVU6NETSECTEST";

Identity identity = context.getObjectByName(Identity.class, identityName);
if (identity == null) {
    return "Identity not found: " + identityName;
}

Application app = context.getObjectByName(Application.class, appName);
if (app == null) {
    return "Application not found: " + appName;
}

IdentityService idService = new IdentityService(context);
List links = idService.getLinks(identity, app);
if (links == null || links.isEmpty()) {
    return identityName + " has no account on " + appName;
}
Link link = (Link) links.get(0);

// AD stores memberOf as full DN, find the real value
String groupValue = null;
List groups = Util.asList(link.getAttribute(attrName));
if (groups != null) {
    for (Object g : groups) {
        String s = String.valueOf(g);
        if (s.equalsIgnoreCase(groupName)
            || s.toUpperCase().startsWith("CN=" + groupName.toUpperCase() + ",")) {
            groupValue = s;
            break;
        }
    }
}
if (groupValue == null) {
    return groupName + " not found on account " + link.getNativeIdentity();
}
log.error("Removing " + groupValue + " from " + link.getNativeIdentity());

ProvisioningPlan plan = new ProvisioningPlan();
plan.setIdentity(identity);
plan.setSource("LCM");
plan.setComments("Removed " + groupName + " via rule");

AccountRequest acctReq = new AccountRequest();
acctReq.setOperation(AccountRequest.Operation.Modify);
acctReq.setApplication(appName);
acctReq.setNativeIdentity(link.getNativeIdentity());

AttributeRequest attrReq = new AttributeRequest();
attrReq.setName(attrName);
attrReq.setOperation(ProvisioningPlan.Operation.Remove);
attrReq.setValue(groupValue);
acctReq.add(attrReq);

plan.add(acctReq);

Provisioner provisioner = new Provisioner(context);
provisioner.execute(plan);

ProvisioningProject project = provisioner.getProject();
String msg = "Removal of " + groupName + " submitted for " + identityName;
if (project != null && project.getMessages() != null) {
    for (Object o : project.getMessages()) {
        Message m = (Message) o;
        if (m.isError()) {
            msg = "Error: " + m.getMessage();
            log.error(msg);
        }
    }
}
return msg;
  ]]></Source>
</Rule>
